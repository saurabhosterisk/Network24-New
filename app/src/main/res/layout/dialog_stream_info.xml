<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#E6000000" android:padding="16dp">
    <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="STREAM INFORMATION &amp; DIAGNOSTICS" android:textColor="@android:color/white" android:textSize="20sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineMid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.5" />

    <com.google.android.material.card.MaterialCardView android:id="@+id/cardStream" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_marginEnd="6dp" android:layout_marginBottom="6dp" app:cardBackgroundColor="#1A1F2C" app:cardCornerRadius="12dp" app:strokeColor="#2A3245" app:strokeWidth="1dp" app:layout_constraintTop_toBottomOf="@id/tvTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/guidelineMid" app:layout_constraintBottom_toTopOf="@id/cardVideoAudio">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HEALTH &amp; DIAGNOSIS" android:textColor="#7FB3FF" android:textSize="15sp" android:textStyle="bold" />
            <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:stretchColumns="1">
                <TableRow><TextView android:text="Health Score" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvHealthScore" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Quality" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvHealthLabel" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Rebuffers" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvRebufferCount" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Buffering Time" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvBufferingTime" android:text="—" android:textColor="@android:color/white"/></TableRow>
            </TableLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:id="@+id/cardPlayback" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="6dp" android:layout_marginTop="10dp" android:layout_marginBottom="6dp" app:cardBackgroundColor="#1A1F2C" app:cardCornerRadius="12dp" app:strokeColor="#2A3245" app:strokeWidth="1dp" app:layout_constraintTop_toBottomOf="@id/tvTitle" app:layout_constraintStart_toEndOf="@id/guidelineMid" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toTopOf="@id/cardNetwork">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PLAYBACK" android:textColor="#7FB3FF" android:textSize="15sp" android:textStyle="bold" />
            <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:stretchColumns="1">
                <TableRow><TextView android:text="State" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvPlayerState" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Buffer" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvBufferedPercent" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Buffer Duration" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvBufferDuration" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Position" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvPosition" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Load State" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvLoading" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Speed" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvPlaybackSpeed" android:text="—" android:textColor="@android:color/white"/></TableRow>
            </TableLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:id="@+id/cardVideoAudio" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginEnd="6dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" app:cardBackgroundColor="#1A1F2C" app:cardCornerRadius="12dp" app:strokeColor="#2A3245" app:strokeWidth="1dp" app:layout_constraintTop_toBottomOf="@id/cardStream" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/guidelineMid" app:layout_constraintBottom_toTopOf="@id/cardDiagnosis">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VIDEO / AUDIO" android:textColor="#7FB3FF" android:textSize="15sp" android:textStyle="bold" />
            <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:stretchColumns="1">
                <TableRow><TextView android:text="Resolution" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvResolution" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Video Codec" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvVideoCodec" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Video Bitrate" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvVideoBitrate" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Frame Rate" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvFrameRate" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Audio Codec" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvAudioCodec" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Audio" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvAudioDetails" android:text="—" android:textColor="@android:color/white"/></TableRow>
            </TableLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:id="@+id/cardNetwork" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="6dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" app:cardBackgroundColor="#1A1F2C" app:cardCornerRadius="12dp" app:strokeColor="#2A3245" app:strokeWidth="1dp" app:layout_constraintTop_toBottomOf="@id/cardPlayback" app:layout_constraintStart_toEndOf="@id/guidelineMid" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toTopOf="@id/cardDiagnosis">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK / SOURCE" android:textColor="#7FB3FF" android:textSize="15sp" android:textStyle="bold" />
            <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:stretchColumns="1">
                <TableRow><TextView android:text="Download" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvDownloadSpeed" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Required" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvRequiredSpeed" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Network" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvNetworkType" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Server" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvServerHost" android:text="—" android:textColor="@android:color/white" android:maxLines="1"/></TableRow>
                <TableRow><TextView android:text="Live Latency" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvLiveLatency" android:text="—" android:textColor="@android:color/white"/></TableRow>
                <TableRow><TextView android:text="Last Error" android:textColor="#A7B0C0" android:textStyle="bold"/><TextView android:id="@+id/tvLastError" android:text="None" android:textColor="@android:color/white" android:maxLines="2"/></TableRow>
            </TableLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:id="@+id/cardDiagnosis" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginTop="6dp" android:layout_marginBottom="8dp" app:cardBackgroundColor="#1A1F2C" app:cardCornerRadius="12dp" app:strokeColor="#2A3245" app:strokeWidth="1dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/cardVideoAudio" app:layout_constraintBottom_toTopOf="@id/bottomButtonsLayout">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="9dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DIAGNOSIS" android:textColor="#7FB3FF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvDiagnosis" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Checking stream health…" android:textColor="@android:color/white" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout android:id="@+id/bottomButtonsLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="end" android:orientation="horizontal" android:paddingTop="8dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <Button android:id="@+id/btnCopy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COPY DIAGNOSTICS" android:focusable="true" />
        <Button android:id="@+id/btnClose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="CLOSE" android:focusable="true" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
