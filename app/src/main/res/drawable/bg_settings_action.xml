<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/selection_surface_pressed"/><corners android:radius="14dp"/><stroke android:width="2dp" android:color="@color/selection_stroke"/></shape></item>
    <item android:state_hovered="true"><shape><solid android:color="@color/selection_surface"/><corners android:radius="14dp"/><stroke android:width="2dp" android:color="@color/selection_stroke"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/selection_surface"/><corners android:radius="14dp"/><stroke android:width="2dp" android:color="@color/selection_stroke"/></shape></item>
    <item><shape><solid android:color="@color/surface"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/divider"/></shape></item>
</selector>
