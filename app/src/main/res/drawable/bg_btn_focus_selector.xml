<?xml version="1.0" encoding="utf-8"?>
<!-- Ye ek selector hai jo button ki state (focused ya normal) ke hisab se background badlega -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/selection_surface_pressed" />
            <stroke android:width="2dp" android:color="@color/selection_stroke" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="oval">
            <solid android:color="@color/selection_surface" />
            <stroke android:width="2dp" android:color="@color/selection_stroke" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/selection_surface" />
            <stroke android:width="2dp" android:color="@color/selection_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <!-- Normal state mein background poori tarah transparent rahega -->
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
