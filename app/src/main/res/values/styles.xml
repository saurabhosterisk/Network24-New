<?xml version="1.0" encoding="utf-8"?>
<resources>

<!-- ================================================= -->
<!--                    TEXT STYLES                     -->
<!-- ================================================= -->

<style name="N24TextDisplay">
    <item name="android:textSize">@dimen/text_display</item>
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textStyle">bold</item>
</style>

<style name="N24TextTitle">
    <item name="android:textSize">@dimen/text_title</item>
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textStyle">bold</item>
</style>

<style name="N24TextSubtitle">
    <item name="android:textSize">@dimen/text_subtitle</item>
    <item name="android:textColor">@color/text_secondary</item>
</style>

<style name="N24TextBody">
    <item name="android:textSize">@dimen/text_body</item>
    <item name="android:textColor">@color/text_primary</item>
</style>

<style name="N24TextCaption">
    <item name="android:textSize">@dimen/text_caption</item>
    <item name="android:textColor">@color/text_hint</item>
</style>

<style name="MultiViewLabel">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_gravity">bottom</item>
    <item name="android:background">#B3000000</item>
    <item name="android:paddingStart">8dp</item>
    <item name="android:paddingEnd">8dp</item>
    <item name="android:paddingTop">5dp</item>
    <item name="android:paddingBottom">5dp</item>
    <item name="android:textColor">#FFFFFF</item>
    <item name="android:textSize">13sp</item>
    <item name="android:maxLines">1</item>
    <item name="android:ellipsize">end</item>
</style>

</resources>
